{
  "name": "unreact",
  "private": true,
  "description": "Building React from scratch to learn how it works.",
  "type": "module",
  "scripts": {
    "start": "bun index.html",
    "dev": "bun --hot index.html",
    "build": "bun build ./index.html --outdir ./dist --target browser",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
